# GPT-Realtime Voice Test Harness Environment Configuration

# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Port (optional, defaults to 3010)
PORT=3010

# Twilio Configuration (optional, for phone integration)
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# Telnyx Configuration (optional, for phone integration)
# Get your API key from: https://portal.telnyx.com/
TELNYX_API_KEY=your-telnyx-api-key-here

# Development Settings (optional)
NODE_ENV=development

# Usage Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace sk-your-openai-api-key-here with your actual OpenAI API key
# 3. Modify PORT if needed (default 3000 works for localhost testing)
# 4. Restart the server after making changes